{
  "name": "offshore-wind-masters-web",
  "private": true,
  "version": "3.59.0-student-quick-start",
  "type": "module",
  "scripts": {
    "sync:data": "node tools/sync-data.mjs",
    "sync:art": "node tools/sync-art.mjs",
    "scene:generate": "python tools/generate-scene-feed-variants.py",
    "scene:approve": "python tools/approve-scene-assets.py",
    "art:manifest": "node tools/build-p01-manifest.mjs",
    "art:qa-overrides": "node tools/apply-art-qa-overrides.mjs",
    "art:visual-overrides": "node tools/apply-visual-qa-overrides.mjs",
    "art:import-correction": "node tools/import-art-correction.mjs",
    "art:r7-preview": "node tools/import-r7-sample-preview.mjs",
    "art:production-candidates": "python tools/generate-production-candidates.py",
    "art:production-review-sheet": "python tools/build-production-review-contact-sheet.py",
    "qa:visual-ledger": "python tools/build-visual-approval-ledger.py",
    "qa:record-visual": "python tools/record-visual-approval.py",
    "qa:release-audit": "node tools/build-release-gate-audit.mjs",
    "qa:visual-dashboard": "python tools/build-visual-approval-dashboard.py",
    "qa:promotion-preflight": "python tools/check-promotion-preflight.py",
    "art:import-production": "node tools/import-production-art.mjs",
    "art:r6-sanitize": "node tools/sanitize-r6-feminine-profile-contradictions.mjs",
    "art:r6-pack": "node tools/export-r6-batch-generation-pack.mjs",
    "art:r7-upgrade": "node tools/upgrade-p01-r6-workforce-diversity.mjs",
    "art:r7-pack": "node tools/export-r6-batch-generation-pack.mjs",
    "dev": "pnpm sync:data && pnpm sync:art && vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "simulate:balance": "node --no-warnings --experimental-strip-types tools/simulate-campaign-balance.ts",
    "simulate:challenge": "node --no-warnings --experimental-strip-types tools/simulate-boss-challenge-balance.ts",
    "smoke:gameplay": "node tools/smoke-gameplay.mjs",
    "smoke:challenge": "node tools/smoke-challenge.mjs",
    "smoke:layout": "node tools/smoke-layout.mjs",
    "smoke:deployment:compact": "node tools/smoke-deployment-compact.mjs",
    "smoke:operation:compact": "node tools/smoke-operation-compact.mjs",
    "smoke:mobile:flow": "node tools/smoke-mobile-flow.mjs",
    "smoke:playtest": "node tools/smoke-playtest.mjs",
    "smoke:course": "node tools/smoke-course-mode.mjs",
    "playtest:summary": "node tools/summarize-playtests.mjs",
    "course:summary": "node tools/summarize-course-records.mjs",
    "smoke:sandbox": "node tools/smoke-sandbox-scenario.mjs",
    "smoke:scene": "node tools/smoke-scene-routing.mjs",
    "smoke:fleet": "node tools/smoke-fleet-maintenance.mjs",
    "smoke:onboarding": "node tools/smoke-onboarding.mjs",
    "smoke:art": "node tools/smoke-source-art.mjs",
    "smoke:visual-ledger": "node tools/smoke-visual-approval-ledger.mjs",
    "smoke:release-audit": "node tools/smoke-release-gate-audit.mjs",
    "smoke:visual-dashboard": "node tools/smoke-visual-approval-dashboard.mjs",
    "build": "pnpm sync:data && pnpm sync:art && tsc --noEmit && vite build",
    "build:course-assets": "python tools/build-course-deployment-assets.py",
    "build:pages": "pnpm sync:data && pnpm sync:art && tsc --noEmit && vite build --mode github-pages && node tools/prepare-course-deployment.mjs --dir dist",
    "build:offline": "pnpm sync:data && pnpm sync:art && tsc --noEmit && vite build --base=./ --outDir dist-offline && node tools/prepare-course-deployment.mjs --dir dist-offline",
    "package:offline": "powershell -ExecutionPolicy Bypass -File tools/package-course-offline.ps1",
    "preview": "vite preview --host 127.0.0.1",
    "validate:data": "python tools/validate_owm_data.py",
    "validate:scene": "python tools/validate-scene-assets.py",
    "validate:art": "node tools/validate-art-prompts.mjs",
    "validate:production-art": "node tools/validate-production-art.mjs",
    "validate:course": "node tools/validate-course-config.mjs",
    "validate:teaching-deployment": "pnpm simulate:challenge && pnpm sync:data && python tools/validate_owm_data.py --course-deployment && pnpm validate:course && pnpm test && pnpm simulate:balance && pnpm build:pages",
    "course:unlock": "node tools/set-course-unlocks.mjs",
    "course:inspect-legacy": "node tools/summarize-course-record.mjs",
    "validate": "pnpm simulate:challenge && pnpm sync:data && pnpm validate:data && pnpm validate:scene && pnpm validate:art && pnpm validate:course && pnpm test && pnpm simulate:balance && pnpm build"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "playwright-core": "1.61.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.7.0"
}
